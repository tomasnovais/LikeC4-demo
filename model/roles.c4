// Organisation roles (ADR 0006): generic kinds of organisation, never named
// organisations. Named organisations appear only in a software product's `usedBy`.
// A role carries the stage tags of the systems it operates, so lifecycle lenses
// filter roles and systems together. A role is only modelled once it operates a
// system (regulator and delivery partner are in GLOSSARY.md but not yet here).

model {

  combinedAuthority = role 'Combined authority' {
    #housing-need #housing-pipeline
    summary 'A combined authority such as Liverpool City Region Combined Authority.'
    metadata { source 'Claude draft 2026-11-03' }
  }

  localAuthority = role 'Local authority' {
    #housing-approval
    summary 'A council, acting among other things as planning authority.'
    metadata { source 'Claude draft 2026-11-03' }
  }

  registeredProvider = role 'Registered provider' {
    #housing-pipeline #housing-scheme-design #housing-approval #housing-construction #housing-handover #housing-portfolio
    summary 'A social housing landlord registered with the regulator.'
    metadata { source 'Claude draft 2026-11-03' }
  }

  contractor = role 'Contractor' {
    #housing-scheme-design #housing-construction #housing-handover
    summary 'Builds or assembles a scheme on site, including in-house contractors.'
    metadata { source 'Claude draft 2026-11-03' }
  }

  architect = role 'Architect' {
    #housing-scheme-design
    metadata { source 'Claude draft 2026-11-03' }
  }

  manufacturer = role 'Manufacturer' {
    #product-development #product-cataloguing #product-manufacture #product-improvement #housing-construction
    summary 'Develops and makes industrialised construction products.'
    metadata { source 'Claude draft 2026-11-03' }
  }

  certificationBody = role 'Certification body' {
    #product-certification
    metadata { source 'Claude draft 2026-11-03' }
  }

  centralGovernment = role 'Central government' {
    #housing-handover #housing-portfolio
    metadata { source 'Claude draft 2026-11-03' }
  }

  funder = role 'Funder' {
    #housing-approval
    metadata { source 'Claude draft 2026-11-03' }
  }
}
