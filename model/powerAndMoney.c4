// Who holds power over whom, and where the money goes. Both run between actor groups
// and stay off the map; each has its own lens (views/lenses.c4). Every figure is invented.
// Labels carry no figures. Figures sit in `technology`, which shows under the label and
// on click, and in metadata as separate fields for filtering (ADR 0005).

model {

  // Power: points from the one holding it. Technology shows the basis, then any figures.

  foodDeliveryPlatforms -[hasPowerOver]-> independentRestaurants 'sets commission and search ranking' {
    #power-high
    technology 'Commercial: 30% commission, 40% of orders, 80 orders a week each'
    description 'The platform brings customers the restaurant could not reach alone, so the restaurant takes the standard terms.'
    metadata { basis 'commercial'; feePercent '30'; shareOfOrdersPercent '40'; transactionVolume '80'; transactionUnit 'orders per restaurant'; transactionPeriod 'week'; source 'Invented' }
  }

  foodDeliveryPlatforms -[hasPowerOver]-> couriers 'allocates work and sets pay' {
    #power-high
    technology 'Dependency: about £4 per drop-off, 3 million jobs a week'
    description 'Couriers depend on the platform for jobs, and the algorithm decides who is offered what.'
    metadata { basis 'dependency'; averageValueGbp '4'; transactionVolume '3000000'; transactionUnit 'delivery jobs'; transactionPeriod 'week'; source 'Invented' }
  }

  foodRegulators -[hasPowerOver]-> independentRestaurants 'publishes the hygiene rating' {
    #power-high
    technology 'Regulatory: 500,000 businesses rated'
    description 'A poor rating is public, and an inspection can close a kitchen.'
    metadata { basis 'regulatory'; transactionVolume '500000'; transactionUnit 'businesses rated'; source 'Invented' }
  }

  restaurantChains -[hasPowerOver]-> foodDeliveryPlatforms 'negotiates rates and can walk away' {
    #power-medium
    technology 'Commercial: about 20% commission, 500 orders a week per site'
    description 'A national brand brings volume the platform wants, so the commission is negotiated.'
    metadata { basis 'commercial'; feePercent '20'; transactionVolume '500'; transactionUnit 'orders per site'; transactionPeriod 'week'; source 'Invented' }
  }

  foodDeliveryPlatforms -[hasPowerOver]-> restaurantChains 'controls placement and promotions' {
    #power-medium
    technology 'Commercial'
    description 'Power runs both ways here: the platform decides how prominently a chain appears, and the chain can take its volume elsewhere.'
    metadata { basis 'commercial'; source 'Invented' }
  }

  customers -[hasPowerOver]-> independentRestaurants 'leaves ratings that drive orders' {
    #power-medium
    technology 'Commercial: 20% of orders get rated'
    description 'One customer has little power, but together their ratings decide which restaurants get seen.'
    metadata { basis 'commercial'; shareOfOrdersPercent '20'; source 'Invented' }
  }

  foodRegulators -[hasPowerOver]-> restaurantChains 'publishes the hygiene rating' {
    #power-medium
    technology 'Regulatory'
    description 'The same rules as for independent restaurants, but one poor rating affects one site rather than the whole business.'
    metadata { basis 'regulatory'; source 'Invented' }
  }

  customers -[hasPowerOver]-> foodDeliveryPlatforms 'can switch app in seconds' {
    #power-low
    technology 'Commercial'
    description 'Switching is free, but most customers stick with the app they already have.'
    metadata { basis 'commercial'; source 'Invented' }
  }

  integrationCompanies -[hasPowerOver]-> restaurantChains 'hard to replace once connected' {
    #power-low
    technology 'Dependency'
    description 'Every till and platform connection would have to be rebuilt to change hub.'
    metadata { basis 'dependency'; source 'Invented' }
  }

  paymentCompanies -[hasPowerOver]-> foodDeliveryPlatforms 'sets processing fees' {
    #power-low
    technology 'Commercial: about 1.5% fee'
    description 'Fees can be negotiated at this volume, and several gateways compete for the business.'
    metadata { basis 'commercial'; feePercent '1.5'; source 'Invented' }
  }

  verificationCompanies -[hasPowerOver]-> couriers 'can block a sign-up' {
    #power-low
    technology 'Dependency'
    description 'A failed check stops a courier working, although the platform decides what happens next.'
    metadata { basis 'dependency'; source 'Invented' }
  }

  // Money: points the way the money goes.

  customers -[pays]-> foodDeliveryPlatforms 'pays for orders' {
    technology 'About £25 per order, 4 million orders a week'
    metadata { averageValueGbp '25'; transactionVolume '4000000'; transactionUnit 'orders'; transactionPeriod 'week'; source 'Invented' }
  }

  foodDeliveryPlatforms -[pays]-> independentRestaurants 'pays order value less commission' {
    technology '30% commission, 80 orders a week each'
    metadata { feePercent '30'; transactionVolume '80'; transactionUnit 'orders per restaurant'; transactionPeriod 'week'; frequency 'weekly'; source 'Invented' }
  }

  foodDeliveryPlatforms -[pays]-> restaurantChains 'pays order value less commission' {
    technology 'About 20% commission, 500 orders a week per site'
    metadata { feePercent '20'; transactionVolume '500'; transactionUnit 'orders per site'; transactionPeriod 'week'; frequency 'weekly'; source 'Invented' }
  }

  foodDeliveryPlatforms -[pays]-> couriers 'pays per drop-off' {
    technology 'About £4 per drop-off, 3 million jobs a week'
    metadata { averageValueGbp '4'; transactionVolume '3000000'; transactionUnit 'delivery jobs'; transactionPeriod 'week'; frequency 'weekly'; source 'Invented' }
  }

  foodDeliveryPlatforms -[pays]-> paymentCompanies 'pays processing fees' {
    technology 'About 1.5% fee, 4 million payments a week'
    metadata { feePercent '1.5'; transactionVolume '4000000'; transactionUnit 'payments'; transactionPeriod 'week'; source 'Invented' }
  }

  foodDeliveryPlatforms -[pays]-> verificationCompanies 'pays per check' {
    technology 'About £2 per check, 5,000 checks a month'
    metadata { feeAmountGbp '2'; feeUnit 'per check'; transactionVolume '5000'; transactionUnit 'checks'; transactionPeriod 'month'; source 'Invented' }
  }

  restaurantChains -[pays]-> integrationCompanies 'pays a subscription' {
    technology 'About £100 a month per site'
    metadata { feeAmountGbp '100'; feeUnit 'per site per month'; source 'Invented' }
  }
}
