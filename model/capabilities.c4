// Capabilities: flat list, verb + noun, tagged with their lifecycles, with the stage in
// metadata. A capability with no system supporting it is a gap: it is tagged #gap and
// is the one kind of element allowed to stay unconnected. See the Capabilities lens.

model {

  // Order lifecycle

  browseMenus = capability 'Browse menus' {
    #lifecycle-order
    metadata { stage 'browse'; source 'Illustrative' }
  }

  placeOrder = capability 'Place order' {
    #lifecycle-order #lifecycle-customer
    metadata { stage 'place'; source 'Illustrative' }
  }

  takeCardPayment = capability 'Take card payment' {
    #lifecycle-order #lifecycle-customer
    metadata { stage 'place'; source 'Illustrative' }
  }

  acceptOrder = capability 'Accept order' {
    #lifecycle-order
    metadata { stage 'accept'; source 'Illustrative' }
  }

  bringOrdersIntoTill = capability 'Bring orders into the till' {
    #lifecycle-order
    metadata { stage 'prepare'; source 'Illustrative' }
  }

  dispatchCourier = capability 'Dispatch courier' {
    #lifecycle-order #lifecycle-courier
    metadata { stage 'drop-off'; source 'Illustrative' }
  }

  settleOrder = capability 'Settle order' {
    #lifecycle-order #lifecycle-restaurant
    metadata { stage 'settle'; source 'Illustrative' }
  }

  // Restaurant lifecycle

  onboardRestaurant = capability 'Onboard restaurant' {
    #lifecycle-restaurant
    metadata { stage 'onboard'; source 'Illustrative' }
  }

  publishMenu = capability 'Publish menu' {
    #lifecycle-restaurant
    metadata { stage 'publish menu'; source 'Illustrative' }
  }

  declareAllergens = capability 'Declare allergens' {
    #lifecycle-restaurant
    metadata { stage 'comply'; source 'Illustrative' }
  }

  publishHygieneRating = capability 'Publish hygiene rating' {
    #lifecycle-restaurant
    metadata { stage 'comply'; source 'Illustrative' }
  }

  recordSales = capability 'Record sales' {
    #lifecycle-restaurant
    metadata { stage 'trade'; source 'Illustrative' }
  }

  keepAccounts = capability 'Keep accounts' {
    #lifecycle-restaurant
    metadata { stage 'get paid'; source 'Illustrative' }
  }

  reconcilePayouts = capability 'Reconcile payouts across platforms' {
    #lifecycle-restaurant #gap #open-question
    summary 'A gap: no system supports this, so restaurants on several platforms do it by hand.'
    link ../backlog/questions/03-who-reconciles-payouts.md 'Open question 03'
    metadata { stage 'get paid'; source 'Illustrative' }
  }

  // Courier lifecycle

  verifyCourier = capability 'Verify courier' {
    #lifecycle-courier
    metadata { stage 'verify'; source 'Illustrative' }
  }

  payCouriers = capability 'Pay couriers' {
    #lifecycle-courier
    metadata { stage 'get paid'; source 'Illustrative' }
  }

  // Customer lifecycle

  manageCustomerAccount = capability 'Manage customer account' {
    #lifecycle-customer
    metadata { stage 'sign up'; source 'Illustrative' }
  }

  handleCustomerHelp = capability 'Handle customer help' {
    #lifecycle-customer
    metadata { stage 'get help'; source 'Illustrative' }
  }
}
