// Actor groups and the actors inside them (ADR 0003). The map shows groups; actors
// appear on zoom views and in the step-through views. An actor connects only to
// its own software, or is connected through its group.
// An actor keeps its everyday name, unless it runs software with the same brand: then
// the actor takes its registered name and the software keeps the brand.
// Invented values stay on groups, never on a named company (ADR 0005).

model {

  customers = actorGroup 'Customers' {
    #lifecycle-order #lifecycle-customer
    summary 'People who order food through a delivery platform system.'
    style { icon bootstrap:people-fill }
    metadata { source 'Illustrative' }

    joeBlogs = actor 'Joe Blogs' {
      summary 'An example customer.'
      metadata { source 'Invented' }
    }
  }

  couriers = actorGroup 'Couriers' {
    #lifecycle-order #lifecycle-courier
    summary 'People who collect orders from restaurants and drop them off with customers.'
    style { icon bootstrap:bicycle }
    metadata { source 'Illustrative' }

    samRivers = actor 'Sam Rivers' {
      summary 'An example courier.'
      metadata { source 'Invented' }
    }
  }

  foodDeliveryPlatforms = actorGroup 'Food delivery platforms' {
    #lifecycle-order #lifecycle-restaurant #lifecycle-courier #lifecycle-customer
    summary 'Businesses that run delivery platform systems.'
    style { icon bootstrap:phone-fill }
    metadata { source 'Illustrative' }

    uberEats = actor 'Uber Eats UK Limited' {
      summary 'Trades as Uber Eats.'
      link https://find-and-update.company-information.service.gov.uk/company/10078453 'Companies House'
      link ../backlog/assumptions/04-registered-names.md 'Assumption 04'
      metadata { tradingName 'Uber Eats'; companyNumber '10078453'; source 'https://find-and-update.company-information.service.gov.uk/company/10078453' }
    }

    deliveroo = actor 'Roofoods Ltd' {
      summary 'Trades as Deliveroo. Owned by DoorDash.'
      link https://ico.org.uk/ESDWebPages/Entry/ZA048107 'ICO register'
      link ../backlog/assumptions/04-registered-names.md 'Assumption 04'
      metadata { tradingName 'Deliveroo'; source 'https://ico.org.uk/ESDWebPages/Entry/ZA048107' }
    }

    justEat = actor 'Just Eat.co.uk Ltd' {
      summary 'Trades as Just Eat. Owned by Prosus.'
      link https://find-and-update.company-information.service.gov.uk/company/04656315 'Companies House'
      metadata { tradingName 'Just Eat'; companyNumber '04656315'; source 'https://find-and-update.company-information.service.gov.uk/company/04656315/filing-history' }
    }
  }

  independentRestaurants = actorGroup 'Independent restaurants' {
    #lifecycle-order #lifecycle-restaurant #assumption
    summary "Restaurants with one site or a few, which take a platform's standard terms."
    link ../backlog/assumptions/02-independents-rekey-orders.md 'Assumption 02'
    style { icon bootstrap:shop }
    metadata { source 'Illustrative' }

    cornerCurryHouse = actor 'Corner Curry House' {
      summary 'An example independent restaurant.'
      metadata { source 'Invented' }
    }
  }

  restaurantChains = actorGroup 'Restaurant chains' {
    #lifecycle-order #lifecycle-restaurant
    summary 'Restaurant brands with many sites, which negotiate their own terms with platforms.'
    style { icon bootstrap:shop-window }
    metadata { source 'Illustrative' }

    nandos = actor "Nando's" {
      summary 'Named as an example of the group only; nothing here describes its actual systems.'
      metadata { source 'Illustrative' }
    }

    wagamama = actor 'Wagamama' {
      summary 'Named as an example of the group only; nothing here describes its actual systems.'
      metadata { source 'Illustrative' }
    }
  }

  integrationCompanies = actorGroup 'Integration companies' {
    #lifecycle-order #lifecycle-restaurant
    summary 'Businesses that run order integration hubs.'
    style { icon bootstrap:plug-fill }
    metadata { source 'Illustrative' }

    deliverect = actor 'Deliverect NV' {
      summary 'Trades as Deliverect. Registered in Belgium.'
      link https://www.deliverect.com/en/online-ordering-terms-and-conditions 'Terms naming the company'
      metadata { tradingName 'Deliverect'; companyNumber '0692.623.253'; source 'https://www.deliverect.com/en/online-ordering-terms-and-conditions' }
    }

    otter = actor 'Otter (registered name not confirmed)' {
      #open-question
      summary 'Trades as Otter. Its registered name could not be found.'
      link ../backlog/questions/04-otter-registered-name.md 'Open question 04'
      link https://www.tryotter.com 'Otter'
      metadata { tradingName 'Otter'; source 'https://www.tryotter.com' }
    }
  }

  paymentCompanies = actorGroup 'Payment companies' {
    #lifecycle-order #lifecycle-customer
    summary 'Businesses that run payment gateways.'
    style { icon bootstrap:credit-card-fill }
    metadata { source 'Illustrative' }

    stripe = actor 'Stripe Payments UK Limited' {
      summary 'Trades as Stripe. Its US entity is Stripe, LLC.'
      link https://stripe.com/legal/spukl 'Terms naming the company'
      metadata { tradingName 'Stripe'; source 'https://support.stripe.com/questions/your-contract-with-stripe-stripe-services-agreement-%28ssa%29-overview-faq' }
    }

    adyen = actor 'Adyen N.V.' {
      summary 'Trades as Adyen.'
      link https://find-and-update.company-information.service.gov.uk/company/OE031010 'Companies House'
      metadata { tradingName 'Adyen'; companyNumber 'OE031010'; source 'https://find-and-update.company-information.service.gov.uk/company/OE031010' }
    }
  }

  verificationCompanies = actorGroup 'Verification companies' {
    #lifecycle-courier
    summary 'Businesses that run identity verification systems.'
    style { icon bootstrap:person-check-fill }
    metadata { source 'Illustrative' }

    onfido = actor 'Onfido Ltd' {
      summary 'Trades as Onfido. Owned by Entrust.'
      link https://find-and-update.company-information.service.gov.uk/company/07479524 'Companies House'
      metadata { tradingName 'Onfido'; companyNumber '07479524'; source 'https://find-and-update.company-information.service.gov.uk/company/07479524/more' }
    }

    yoti = actor 'Yoti Ltd' {
      summary 'Trades as Yoti.'
      link https://find-and-update.company-information.service.gov.uk/company/08998951 'Companies House'
      metadata { tradingName 'Yoti'; companyNumber '08998951'; source 'https://find-and-update.company-information.service.gov.uk/company/08998951' }
    }
  }

  foodRegulators = actorGroup 'Food regulators' {
    #lifecycle-restaurant
    summary 'Public bodies that set and enforce food safety rules and publish hygiene ratings.'
    style { icon bootstrap:shield-check }
    metadata { source 'Illustrative' }

    foodStandardsAgency = actor 'Food Standards Agency' {
      link https://www.food.gov.uk 'Food Standards Agency'
      metadata { source 'https://www.food.gov.uk' }
    }

    localAuthorityFoodTeams = actor 'Local authority food teams' {
      summary 'Inspect food businesses and award their hygiene ratings.'
      metadata { source 'https://www.food.gov.uk/safety-hygiene/food-hygiene-rating-scheme' }
    }
  }
}
