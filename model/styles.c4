// Shared view styling. The map and every zoom view apply it with:
//   global style conventions

global {
  styleGroup conventions {
    // API readiness of software products: the same logic as the flow colours
    style element.tag = #api-public { color green }
    style element.tag = #api-partner { color amber }
    style element.tag = #api-none { color red }

    // A gap stands out wherever it appears
    style element.tag = #gap { color red; border dashed }
  }
}
