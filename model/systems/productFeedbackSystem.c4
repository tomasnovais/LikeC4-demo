model {

  productFeedbackSystem = system 'Product feedback system' {
    #product-improvement #housing-portfolio #state-planned #idcc-scope
    summary 'Gathers how products perform on site and in occupied homes, for their next version. No software product fills this role yet.'
    metadata { source 'Claude draft 2026-11-03' }

    productPerformanceFeedback = dataset 'Product performance feedback' {
      #info-product-performance-feedback #authoritative #state-planned #idcc-scope
      metadata { source 'Claude draft 2026-11-03' }
    }
  }

  productFeedbackSystem -[supports]-> learnFromProductPerformance

  productFeedbackSystem.productPerformanceFeedback -[api]-> productInformationManagementSystem.productSpecifications 'feedback for the next product version' {
    #state-planned #idcc-scope
    metadata { frequency 'monthly'; standards ['idccDataStandards']; source 'Claude draft 2026-11-03' }
  }
}

views {

  // Zoom view: opens when this system is clicked on the map (ADR 0007)
  view productFeedbackSystemZoom of productFeedbackSystem {
    title 'Product feedback system'
    include *
    include * -> productFeedbackSystem where kind is operates
    include productFeedbackSystem -> * where kind is supports
    global style idccConventions
    autoLayout LeftRight
  }
}
