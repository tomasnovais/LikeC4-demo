model {

  planningCaseManagementSystem = system 'Planning case management system' {
    #housing-approval
    summary "The planning authority's system for receiving and determining planning applications."
    metadata { source 'Claude draft 2026-11-03' }

    planningApplications = dataset 'Planning applications' {
      #info-planning-application #authoritative #state-current
      metadata { source 'Claude draft 2026-11-03' }
    }

    planningDecisions = dataset 'Planning decisions' {
      #info-planning-decision #authoritative #state-current
      metadata { source 'Claude draft 2026-11-03' }
    }
  }

  localAuthority -[operates]-> planningCaseManagementSystem
  planningCaseManagementSystem -[supports]-> determinePlanningApplication

  planningCaseManagementSystem.planningDecisions -[rekeying]-> schemeManagementSystem.planningDecisions 'decision notice' {
    #state-current
    metadata { frequency 'per application'; source 'Claude draft 2026-11-03' }
  }
}

views {

  // Zoom view: opens when this system is clicked on the map (ADR 0007)
  view planningCaseManagementSystemZoom of planningCaseManagementSystem {
    title 'Planning case management system'
    include *
    include * -> planningCaseManagementSystem where kind is operates
    include planningCaseManagementSystem -> * where kind is supports
    global style idccConventions
    autoLayout LeftRight
  }
}
