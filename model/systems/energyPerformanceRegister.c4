model {

  energyPerformanceRegister = system 'Energy performance register' {
    #housing-handover #housing-portfolio
    summary 'National register of energy performance assessments for homes.'
    metadata { source 'Claude draft 2026-11-03' }

    energyPerformance = dataset 'Energy performance' {
      #info-energy-performance #authoritative #state-current
      metadata { source 'Claude draft 2026-11-03' }
    }
  }

  centralGovernment -[operates]-> energyPerformanceRegister

  energyPerformanceRegister.energyPerformance -[fileTransfer]-> assetManagementSystem.energyPerformance 'energy performance download' {
    #state-current
    metadata { frequency 'monthly'; source 'Claude draft 2026-11-03' }
  }
}

views {

  // Zoom view: opens when this system is clicked on the map (ADR 0007)
  view energyPerformanceRegisterZoom of energyPerformanceRegister {
    title 'Energy performance register'
    include *
    include * -> energyPerformanceRegister where kind is operates
    include energyPerformanceRegister -> * where kind is supports
    global style idccConventions
    autoLayout LeftRight
  }
}
