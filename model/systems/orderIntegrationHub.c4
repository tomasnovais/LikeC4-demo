model {

  orderIntegrationHub = system 'Order integration hub' {
    #lifecycle-order #lifecycle-restaurant
    summary "Brings a restaurant's orders from many delivery platform systems into its till system."
    style { icon bootstrap:diagram-3-fill }
    metadata { source 'Illustrative' }

    deliverectHub = softwareProduct 'Deliverect' {
      #api-public
      link https://developers.deliverect.com 'Developer documentation'
      metadata { vendor 'Deliverect'; usedBy ['Restaurant chains']; source 'https://developers.deliverect.com' }
    }

    otterHub = softwareProduct 'Otter' {
      #api-partner
      link https://www.tryotter.com 'Otter'
      metadata { vendor 'Otter'; usedBy ['Restaurant chains']; source 'Illustrative' }
    }

    orders = dataset 'Orders' {
      #info-order #copy
      metadata { source 'Illustrative' }
    }

    menus = dataset 'Menus' {
      #info-menu #copy
      metadata { source 'Illustrative' }
    }
  }

  integrationCompanies -[operates]-> orderIntegrationHub {
    description '''
      **Relationship data**

      | Measure | Value |
      | --- | --- |
      | Transaction volume | 1,000,000 orders a week |
      | Data source | Invented |
    '''
    metadata { source 'Invented' }
  }
  integrationCompanies.deliverect -[operates]-> orderIntegrationHub.deliverectHub
  integrationCompanies.otter -[operates]-> orderIntegrationHub.otterHub

  restaurantChains -[uses]-> orderIntegrationHub 'routes orders' {
    description '''
      **Relationship data**

      | Measure | Value |
      | --- | --- |
      | Transaction volume | 500 orders per site a week |
      | Data source | Invented |
    '''
    metadata { source 'Invented' }
  }

  orderIntegrationHub -[supports]-> bringOrdersIntoTill
  orderIntegrationHub -[supports]-> publishMenu

  orderIntegrationHub.menus -[conformsTo]-> schemaOrgMenu

  orderIntegrationHub.orders -[api]-> tillSystem.orders 'order sent straight to the till' {
    description '''
      **Relationship data**

      | Measure | Value |
      | --- | --- |
      | Transaction volume | 500 orders per site a week |
      | Frequency | Per order |
      | Data source | Invented |

      **Example schema: till order**

      | Field | Type | Notes |
      | --- | --- | --- |
      | orderId | string | The hub's reference, with the platform's alongside |
      | tillProductCode | string | The hub maps dishes to till codes |
      | quantity | number | How many |
      | collectBy | time | When the courier arrives |
    '''
    metadata { schemaName 'Till order'; source 'Illustrative' }
  }

  orderIntegrationHub.menus -[api]-> deliveryPlatformSystem.restaurantPortal.menus 'menu published to every platform' {
    description '''
      **Relationship data**

      | Measure | Value |
      | --- | --- |
      | Transaction volume | 20 updates per site a week |
      | Frequency | On change |
      | Data source | Invented |

      **Example schema: menu update**

      | Field | Type | Notes |
      | --- | --- | --- |
      | siteId | string | Which site |
      | itemId | string | The dish |
      | price | money | Can differ by platform |
      | available | boolean | Switches a dish off when it runs out |
      | allergens | list | From the 14 allergens |
    '''
    metadata { schemaName 'Menu update'; source 'Illustrative' }
  }
}

views "System zooms" {

  // Zoom view: opens when this system is clicked on the map (ADR 0004)
  view orderIntegrationHubZoom of orderIntegrationHub {
    title 'Order integration hub'
    description 'Zoom into this system: the information it holds, who operates it, the capabilities it supports and the systems it exchanges information with.'
    include *
    include integrationCompanies.*
    include * -> orderIntegrationHub where kind is operates or kind is uses
    include orderIntegrationHub -> * where kind is supports
    global style conventions
    autoLayout LeftRight
  }
}
