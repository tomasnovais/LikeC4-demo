model {

  certificationManagementSystem = system 'Certification management system' {
    #product-certification
    summary "A certification body's system for assessing products and issuing certificates."
    metadata { source 'Claude draft 2026-11-03' }

    testEvidence = dataset 'Test evidence' {
      #info-test-evidence #copy #state-current
      metadata { source 'Claude draft 2026-11-03' }
    }

    productCertificates = dataset 'Product certificates' {
      #info-product-certificate #authoritative #state-current
      metadata { source 'Claude draft 2026-11-03' }
    }
  }

  certificationBody -[operates]-> certificationManagementSystem
  certificationManagementSystem -[supports]-> certifyProduct

  certificationManagementSystem.productCertificates -[rekeying]-> productCatalogue.productCertificates 'certificate details re-entered' {
    #state-retiring
    metadata { frequency 'per certificate'; source 'Claude draft 2026-11-03' }
  }

  certificationManagementSystem.productCertificates -[api]-> productCatalogue.productCertificates 'digital certificates' {
    #state-planned #idcc-scope
    metadata { frequency 'on change'; standards ['idccDataStandards']; source 'Claude draft 2026-11-03' }
  }
}

views {

  // Zoom view: opens when this system is clicked on the map (ADR 0007)
  view certificationManagementSystemZoom of certificationManagementSystem {
    title 'Certification management system'
    description 'Zoom into this system: the information it holds, who operates it, the capabilities it supports and the systems it exchanges information with.'
    include *
    include * -> certificationManagementSystem where kind is operates
    include certificationManagementSystem -> * where kind is supports
    global style idccConventions
    autoLayout LeftRight
  }
}
