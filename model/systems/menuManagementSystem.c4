model {

  menuManagementSystem = system 'Menu management system' {
    #lifecycle-restaurant #assumption
    summary 'Where a restaurant keeps the master version of its menu, even if that is only a spreadsheet.'
    link ../../backlog/assumptions/01-one-master-menu.md 'Assumption 01'
    style { icon bootstrap:journal-text }
    metadata { source 'Illustrative' }

    menuSpreadsheet = softwareProduct 'Menu spreadsheet' {
      #api-none
      summary 'Often what this role comes down to: a file on a back-office PC.'
      metadata { vendor 'None: kept by the restaurant'; usedBy ['Independent restaurants']; source 'Illustrative' }
    }

    menus = dataset 'Menus' {
      #info-menu #authoritative #assumption
      summary 'The master menu. Open its details to see the schema.'
      description '''
        **Example schema: menu item**

        | Field | Type | Notes |
        | --- | --- | --- |
        | itemId | string | The restaurant's own code |
        | name | string | As customers see it |
        | price | money | Before any platform uplift |
        | allergens | list | From the 14 allergens |
        | available | boolean | Whether it can be ordered today |
      '''
      link ../../backlog/assumptions/01-one-master-menu.md 'Assumption 01'
      metadata { fields ['itemId', 'name', 'price', 'allergens', 'available']; source 'Illustrative' }
    }
  }

  independentRestaurants -[operates]-> menuManagementSystem
  restaurantChains -[operates]-> menuManagementSystem

  menuManagementSystem -[supports]-> publishMenu
  menuManagementSystem -[supports]-> declareAllergens

  menuManagementSystem.menus -[conformsTo]-> fourteenAllergens

  menuManagementSystem.menus -[rekeying]-> deliveryPlatformSystem.restaurantPortal.menus 'menu typed into each platform' {
    description '''
      Each platform has its own screens, so the same menu is typed in once per platform, and a price change means doing it all again.

      **Proposed schema: menu update**, what an integration would need to send instead

      | Field | Type | Notes |
      | --- | --- | --- |
      | itemId | string | The restaurant's own code |
      | name | string | As customers see it |
      | price | money | Can differ by platform |
      | allergens | list | From the 14 allergens |

      **Volume:** about 10 updates a week per restaurant, for each platform (illustrative).
    '''
    metadata { frequency 'on change'; transactionVolume '10 updates a week per restaurant'; schemaName 'Menu update'; source 'Illustrative' }
  }

  menuManagementSystem.menus -[fileTransfer]-> orderIntegrationHub.menus 'menu exported to the hub' {
    description '''
      **Example schema: menu file**

      | Field | Type | Notes |
      | --- | --- | --- |
      | itemId | string | The restaurant's own code |
      | name | string | As customers see it |
      | basePrice | money | The hub applies each platform's uplift |
      | allergens | list | Separated by semicolons |
    '''
    metadata { frequency 'on change'; transactionVolume 'A few files a month per chain'; schemaName 'Menu file'; source 'Illustrative' }
  }
}

views "System zooms" {

  // Zoom view: opens when this system is clicked on the map (ADR 0004)
  view menuManagementSystemZoom of menuManagementSystem {
    title 'Menu management system'
    description 'Zoom into this system: the information it holds, who operates it, the capabilities it supports and the systems it exchanges information with.'
    include *
    include * -> menuManagementSystem where kind is operates or kind is uses
    include menuManagementSystem -> * where kind is supports
    global style conventions
    autoLayout LeftRight
  }
}
