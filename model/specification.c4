// Food delivery reference architecture: element kinds, relationship kinds and tags.
// Terms are defined in GLOSSARY.md; decisions behind them are in docs/adr/.
// Rules LikeC4 cannot enforce (e.g. "exactly one information type tag") are
// listed in backlog/model-checks/issues/01-tag-rule-check-script.md.

specification {

  // ---------------------------------------------------------------------------
  // Element kinds
  // Shape says what something is; colour separates who (slate) from software (blue).
  // Software products are coloured by API readiness instead (model/styles.c4).
  // ---------------------------------------------------------------------------

  // A category of actors, such as food delivery platforms or customers (ADR 0003)
  element actorGroup {
    notation "Actor group"
    style {
      shape rectangle
      color slate
      multiple true
    }
  }

  // A specific, named member of an actor group, such as Uber Eats or Joe Blogs
  element actor {
    notation "Actor"
    style {
      shape person
      color slate
    }
  }

  // Supplier-neutral kind of software, defined by its role (ADR 0003)
  element system {
    notation "System"
    style {
      shape rectangle
      color primary
    }
  }

  element subsystem {
    notation "Subsystem"
    style {
      shape rectangle
      color sky
    }
  }

  // Real software filling a system's role; nested in that system
  element softwareProduct {
    notation "Software product"
    style {
      shape component
      color gray
    }
  }

  // Information of one information type held in one system (ADR 0001)
  element dataset {
    notation "Dataset"
    style {
      shape storage
      color indigo
    }
  }

  // Verb + noun, e.g. "Place order"
  element capability {
    notation "Capability"
    style {
      shape rectangle
      color muted
      icon bootstrap:bullseye
    }
  }

  element standard {
    notation "Standard"
    style {
      shape document
      color muted
    }
  }

  // ---------------------------------------------------------------------------
  // Deployment node kinds (Infrastructure view)
  // ---------------------------------------------------------------------------

  deploymentNode place {
    notation "Place"
    style {
      color gray
    }
  }

  deploymentNode device {
    notation "Device or server"
    style {
      color slate
    }
  }

  // ---------------------------------------------------------------------------
  // Relationship kinds (legend: docs/legend.md)
  // Structural relationships are plain solid grey lines. Information flows between
  // datasets are always dotted and coloured by mechanism, so manual re-keying stands
  // out in every view. Power and money are solid and coloured, and only appear in
  // their own lenses. Figures and schemas go in the label or description, because
  // the app and the query tools do not show relationship metadata (ADR 0005).
  // ---------------------------------------------------------------------------

  // actor or actor group -> system or software product
  relationship operates {
    title 'operates'
    notation 'Runs a system and is responsible for its information'
    color gray
    line solid
  }

  // actor group -> system or subsystem
  relationship uses {
    title 'uses'
    notation 'Depends on a system without running it'
    color gray
    line solid
  }

  // system or subsystem -> capability
  relationship supports {
    title 'supports'
    notation 'A system supports a capability'
    color gray
    line solid
  }

  // dataset -> standard
  relationship conformsTo {
    title 'conforms to'
    notation 'Information follows a standard'
    color gray
    line solid
  }

  // dataset -> dataset
  relationship api {
    technology "API"
    notation 'Information passes automatically'
    color green
    line dotted
  }

  relationship fileTransfer {
    technology "File transfer"
    notation 'Information passes as a file'
    color blue
    line dotted
  }

  relationship rekeying {
    technology "Manual re-keying"
    notation 'Information typed in again by hand'
    color red
    line dotted
  }

  // actor group -> actor group, pointing from the one holding the power
  relationship hasPowerOver {
    title 'has power over'
    notation 'Can set terms for, or constrain, the other'
    color amber
    line solid
  }

  // actor group -> actor group, pointing the way the money goes
  relationship pays {
    title 'pays'
    notation 'Money passes from one to the other'
    color indigo
    line solid
  }

  // ---------------------------------------------------------------------------
  // Tags: closed vocabularies used for filtering and colouring.
  // Anything not used for filtering belongs in metadata instead.
  // ---------------------------------------------------------------------------

  // Lifecycles (one or more on actor groups, systems, subsystems and capabilities)
  tag lifecycle-order
  tag lifecycle-restaurant
  tag lifecycle-courier
  tag lifecycle-customer

  // Information types (exactly one on each dataset)
  tag info-order
  tag info-menu
  tag info-restaurant-profile
  tag info-customer-account
  tag info-courier-profile
  tag info-verification-result
  tag info-delivery-job
  tag info-payment
  tag info-payout
  tag info-sales-record
  tag info-accounts
  tag info-hygiene-rating
  tag info-customer-rating

  // Authority (exactly one on each dataset)
  tag authoritative
  tag copy

  // API readiness (exactly one on software products)
  tag api-public
  tag api-partner
  tag api-none

  // Strength of power (exactly one on hasPowerOver relationships)
  tag power-high
  tag power-medium
  tag power-low

  // Something filed against this element in backlog/questions or backlog/assumptions
  tag open-question
  tag assumption

  // A capability no system supports
  tag gap
}
