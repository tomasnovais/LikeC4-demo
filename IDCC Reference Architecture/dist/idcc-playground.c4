    global style idccConventions
    autoLayout LeftRight
  }
}

// ==== model/systems/productInformationManagementSystem.c4 ====

model {

  productInformationManagementSystem = system 'Product information management system' {
    #product-development #product-cataloguing #product-improvement
    summary "A manufacturer's system for product specifications, test evidence and the product data it publishes."
    metadata { source 'Claude draft 2026-11-03' }

    productSpecifications = dataset 'Product specifications' {
