  productFeedbackSystem.productPerformanceFeedback -[api]-> productInformationManagementSystem.productSpecifications 'feedback for the next product version' {
    #state-planned #idcc-scope
    metadata { frequency 'monthly'; standards ['idccDataStandards']; source 'Claude draft 2026-11-03' }
  }
}

views {

