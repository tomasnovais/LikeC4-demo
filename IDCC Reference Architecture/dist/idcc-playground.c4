// ==== model/systems/housingPipelineSystem.c4 ====

model {

  housingPipelineSystem = system 'Housing pipeline system' {
    #housing-need #housing-pipeline
    summary 'Records housing need and the pipeline of proposed and active schemes for an area.'
    metadata { source 'Claude draft 2026-11-03' }

    housingNeed = dataset 'Housing need' {
      #info-housing-need #authoritative #state-current
      metadata { source 'Claude draft 2026-11-03' }
    }

    schemeProposals = dataset 'Scheme proposals' {
      #info-scheme-proposal #copy #state-current
      metadata { source 'Claude draft 2026-11-03' }
    }

    liverpoolHousingPipeline = softwareProduct 'Liverpool housing pipeline' {
      #lcr #state-current #prov-bespoke
      description 'Where housing need is currently captured in Liverpool City Region. Operator and provenance unconfirmed.'
      link ../../backlog/questions/01-who-operates-liverpool-housing-pipeline.md 'Open question 01'
      metadata { source 'Tomás Novais, grilling session 2026-11-03' }
    }
  }

  combinedAuthority -[operates]-> housingPipelineSystem
  housingPipelineSystem -[supports]-> assessHousingNeed
  housingPipelineSystem -[supports]-> prioritisePipeline

  housingPipelineSystem.housingNeed -[api]-> demandAggregationSystem.housingNeed 'housing need for demand aggregation' {
    #state-planned #idcc-scope
    metadata { frequency 'monthly'; standards ['idccDataStandards']; source 'Claude draft 2026-11-03' }
  }

  housingPipelineSystem.schemeProposals -[api]-> demandAggregationSystem.schemeProposals 'pipeline for demand aggregation' {
    #state-planned #idcc-scope
    metadata { frequency 'monthly'; standards ['idccDataStandards']; source 'Claude draft 2026-11-03' }
  }
}

views {

  // Zoom view: opens when this system is clicked on the map (ADR 0007)
  view housingPipelineSystemZoom of housingPipelineSystem {
    title 'Housing pipeline system'
    description 'Zoom into this system: the information it holds, who operates it, the capabilities it supports and the systems it exchanges information with.'
    include *
    include * -> housingPipelineSystem where kind is operates
    include housingPipelineSystem -> * where kind is supports
    global style idccConventions
    autoLayout LeftRight
  }
}

// ==== model/systems/manufacturingManagementSystem.c4 ====

model {

  manufacturingManagementSystem = system 'Manufacturing management system' {
    #product-manufacture #housing-construction
    summary "A manufacturer's system for product orders, production and supply to site."
    metadata { source 'Claude draft 2026-11-03' }

    productOrders = dataset 'Product orders' {
      #info-product-order #authoritative #state-current
      metadata { source 'Claude draft 2026-11-03' }
    }

    supplyRecords = dataset 'Supply records' {
      #info-supply-record #authoritative #state-current
      metadata { source 'Claude draft 2026-11-03' }
    }
  }

  manufacturer -[operates]-> manufacturingManagementSystem
  manufacturingManagementSystem -[supports]-> manufactureAndSupplyProducts

  manufacturingManagementSystem.supplyRecords -[rekeying]-> commonDataEnvironment.constructionProgress 'delivery notes' {
    #state-retiring
    metadata { frequency 'per delivery'; source 'Claude draft 2026-11-03' }
  }

  manufacturingManagementSystem.supplyRecords -[api]-> commonDataEnvironment.constructionProgress 'products supplied to site' {
    #state-planned #idcc-scope
    metadata { frequency 'per delivery'; standards ['idccDataStandards']; source 'Claude draft 2026-11-03' }
  }
}

views {

  // Zoom view: opens when this system is clicked on the map (ADR 0007)
  view manufacturingManagementSystemZoom of manufacturingManagementSystem {
    title 'Manufacturing management system'
    description 'Zoom into this system: the information it holds, who operates it, the capabilities it supports and the systems it exchanges information with.'
    include *
    include * -> manufacturingManagementSystem where kind is operates
    include manufacturingManagementSystem -> * where kind is supports
    global style idccConventions
    autoLayout LeftRight
  }
}

// ==== model/systems/planningCaseManagementSystem.c4 ====

model {

  planningCaseManagementSystem = system 'Planning case management system' {
