  }
}

// ==== model/systems/schemeManagementSystem.c4 ====

model {

  schemeManagementSystem = system 'Scheme management system' {
    #housing-pipeline #housing-scheme-design #housing-approval #housing-construction
    summary "A registered provider's record of its schemes from proposal to completion: brief, costs, approvals and progress."
    metadata { source 'Claude draft 2026-11-03' }

    schemeProposals = dataset 'Scheme proposals' {
      #info-scheme-proposal #authoritative #state-current
      metadata { source 'Claude draft 2026-11-03' }
    }

    schemeBriefs = dataset 'Scheme briefs' {
      #info-scheme-brief #authoritative #state-current
      metadata { source 'Claude draft 2026-11-03' }
    }

    costPlans = dataset 'Cost plans' {
      #info-cost-plan #authoritative #state-current
      metadata { source 'Claude draft 2026-11-03' }
    }

    fundingApprovals = dataset 'Investment board approvals' {
      #info-funding-approval #authoritative #state-current
      metadata { source 'Claude draft 2026-11-03' }
    }

    planningDecisions = dataset 'Planning decisions' {
      #info-planning-decision #copy #state-current
      metadata { source 'Claude draft 2026-11-03' }
    }

    constructionProgress = dataset 'Construction progress' {
      #info-construction-progress #copy #state-current
      metadata { source 'Claude draft 2026-11-03' }
    }
  }

  registeredProvider -[operates]-> schemeManagementSystem
  schemeManagementSystem -[supports]-> prioritisePipeline
  schemeManagementSystem -[supports]-> appraiseScheme
  schemeManagementSystem -[supports]-> approveFunding

  schemeManagementSystem.schemeProposals -[rekeying]-> housingPipelineSystem.schemeProposals 'pipeline returns' {
    #state-current
    metadata { frequency 'quarterly'; source 'Claude draft 2026-11-03' }
  }

  schemeManagementSystem.schemeBriefs -[rekeying]-> configurator.schemeBriefs 'brief entered into configurator' {
    #state-retiring
    metadata { frequency 'ad hoc'; source 'Claude draft 2026-11-03' }
  }

  schemeManagementSystem.schemeBriefs -[api]-> configurator.schemeBriefs 'brief sent to configurator' {
    #state-planned #idcc-scope
    metadata { frequency 'ad hoc'; standards ['idccDataStandards']; source 'Claude draft 2026-11-03' }
  }
}

views {

  // Zoom view: opens when this system is clicked on the map (ADR 0007)
  view schemeManagementSystemZoom of schemeManagementSystem {
    title 'Scheme management system'
    description 'Zoom into this system: the information it holds, who operates it, the capabilities it supports and the systems it exchanges information with.'
    include *
    include * -> schemeManagementSystem where kind is operates
    include schemeManagementSystem -> * where kind is supports
    global style idccConventions
    autoLayout LeftRight
  }
}

// ==== views/map.c4 ====

// The map (ADR 0007): the one view defined from scratch. Every lens extends it;
// clicking a system opens that system's zoom view (defined in its own file).

views {

  view index {
    title 'Landscape'
    description 'Every system and organisation role, with who operates what. Click a system to zoom into its datasets; click a flow to see the dataset-level flows behind it.'
    include * where kind is role or kind is system
    global style idccConventions
    autoLayout LeftRight
  }
}

// ==== views/lenses.c4 ====

// Lenses (ADR 0007): each one extends the map and only filters it, or opens one
// information type's datasets inside their systems (an information thread).

views {

  // Roadmap lenses

  view currentState extends index {
    title 'Landscape: current state'
    description 'As it exists today: current and retiring systems and flows.'
    exclude * where tag is #state-planned or tag is #state-retired
    exclude * -> * where tag is #state-planned or tag is #state-retired
  }

  view targetState extends index {
    title 'Landscape: target state'
    description 'Once planned systems and flows are delivered and retiring ones are gone.'
    exclude * where tag is #state-retiring or tag is #state-retired
    exclude * -> * where tag is #state-retiring or tag is #state-retired
  }

  view idccScope extends index {
    title 'Landscape: IDCC scope'
    description 'Only the flows IDCC builds, integrates or standardises; dashed items are planned, i.e. IDCC interventions.'
    exclude * where kind is role
    exclude * -> * where tag is not #idcc-scope
    // Systems with no IDCC flow would be left unconnected. LikeC4 can't filter on
    // "has no relationships", so they are listed by hand; the model check script
    // reports any element left unconnected in a view.
    exclude energyPerformanceRegister, grantFundingSystem, planningCaseManagementSystem
    include idccDataStandards
  }

  // Lifecycle lenses

  view housingLifecycle extends index {
    title 'Landscape: housing delivery lifecycle'
    description 'Systems serving at least one housing delivery stage, and the roles that operate them.'
    exclude *
      where (kind is system or kind is role) and not (
        tag is #housing-need or tag is #housing-pipeline or tag is #housing-scheme-design or
        tag is #housing-approval or tag is #housing-construction or tag is #housing-handover or
        tag is #housing-portfolio
      )
  }

  view productLifecycle extends index {
    title 'Landscape: product lifecycle'
    description 'Systems serving at least one product lifecycle stage, and the roles that operate them.'
    exclude *
      where (kind is system or kind is role) and not (
        tag is #product-development or tag is #product-certification or tag is #product-cataloguing or
        tag is #product-manufacture or tag is #product-improvement
      )
  }

  // Information threads (added on request)

  view productDataThread extends index {
    title 'Landscape: product data'
    description 'Where product data is authoritative, where it is copied, and how it moves today and in the target state.'
    include * where tag is #info-product-data
  }
}
