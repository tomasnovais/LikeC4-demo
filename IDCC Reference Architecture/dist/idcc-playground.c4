  productInformationManagementSystem.productData -[api]-> productCatalogue.productData 'product data publication' {
    #state-planned #idcc-scope
    metadata { frequency 'on change'; standards ['etim', 'uniclass', 'idccDataStandards']; source 'Claude draft 2026-11-03' }
  }
}

