// IDCC Reference Architecture, combined for the LikeC4 playground.
// Generated by scripts/build-playground.mjs on 2026-11-03. Do not edit:
// change the source files and regenerate.

// ==== model/specification.c4 ====

// IDCC reference architecture: element kinds, relationship kinds and tags.
// Terms are defined in GLOSSARY.md; decisions behind them are in docs/adr/.
// Rules LikeC4 cannot enforce (e.g. "exactly one roadmap state tag") are
// listed in backlog/model-checks/issues/01-tag-rule-check-script.md.

specification {

  // ---------------------------------------------------------------------------
  // Element kinds
  // Shape says what something is; border says its roadmap state (model/styles.c4);
  // the only strong colour (primary) is reserved for IDCC scope.
  // ---------------------------------------------------------------------------

  element role {
    notation "Organisation role"
    style {
      shape person
      color slate
    }
  }

  // Supplier-neutral kind of software, defined by its role (ADR 0006)
  element system {
    notation "System"
    style {
      shape rectangle
      color gray
    }
  }

  element subsystem {
    notation "Subsystem"
    style {
      shape rectangle
      color gray
    }
  }

  // Notable example filling a system's role; nested in that system
  element softwareProduct {
    notation "Software product"
    style {
      shape component
      color slate
    }
  }

  // Information of one information type held in one system (ADR 0002)
  element dataset {
    notation "Dataset"
    style {
      shape storage
      color slate
    }
  }

  // Verb + noun, e.g. "Assess housing need"
  element capability {
    notation "Capability"
    style {
      shape rectangle
      color muted
      icon bootstrap:bullseye
    }
  }

  element standard {
    notation "Standard"
    style {
      shape document
      color muted
    }
  }

  // ---------------------------------------------------------------------------
  // Relationship kinds (legend: docs/legend.md)
  // Structural relationships are plain solid grey lines, labelled with what the
  // relationship is. Information flows between datasets are always dotted, and
  // coloured by mechanism, so each flow has exactly one mechanism and manual
  // re-keying stands out in every view. The standards a flow follows go in its
  // `standards` metadata key (a list of standard ids).
  // ---------------------------------------------------------------------------

  // role -> system
  relationship operates {
    title 'operates'
    notation 'An organisation role runs a system'
    color gray
    line solid
  }

  // system -> capability
  relationship supports {
    title 'supports'
    notation 'A system supports a capability'
    color gray
    line solid
  }

  // dataset -> standard
  relationship conformsTo {
    title 'conforms to'
    notation 'Information follows a standard'
    color gray
    line solid
  }

  // dataset -> dataset
  relationship api {
    technology "API"
    notation 'Information passes automatically'
    color green
    line dotted
  }

  relationship fileTransfer {
    technology "File transfer"
    notation 'Information passes as a file'
    color blue
    line dotted
  }

  relationship rekeying {
    technology "Manual re-keying"
    notation 'Information typed in again by hand'
    color red
    line dotted
  }

  // ---------------------------------------------------------------------------
  // Tags: closed vocabularies used for filtering and colouring (Q5 rule).
  // Anything not used for filtering belongs in metadata instead.
  // ---------------------------------------------------------------------------

  // Roadmap state (exactly one on software products, datasets, flows, standards;
  // on systems only when the role itself is new or going away)
  tag state-current
  tag state-planned
  tag state-retiring
  tag state-retired

  // Geographic scope (optional; untagged means national)
  tag lcr

  // Provenance (exactly one on software products)
  tag prov-off-the-shelf
  tag prov-configured
  tag prov-bespoke
  tag prov-idcc-built

  // Housing delivery lifecycle stages (one or more on roles, systems, datasets, capabilities;
  // a role carries the stages of the systems it operates)
  tag housing-need
  tag housing-pipeline
  tag housing-scheme-design
  tag housing-approval
  tag housing-construction
  tag housing-handover
  tag housing-portfolio

  // Product lifecycle stages (one or more on roles, systems, datasets, capabilities)
  tag product-development
  tag product-certification
  tag product-cataloguing
  tag product-manufacture
  tag product-improvement

  // Information types: housing (exactly one on each dataset)
  tag info-housing-need
  tag info-scheme-proposal
  tag info-site-information
  tag info-scheme-brief
  tag info-home-design
  tag info-cost-plan
  tag info-planning-application
  tag info-planning-decision
  tag info-funding-approval
  tag info-contract
  tag info-construction-progress
  tag info-inspection-record
  tag info-handover-information
  tag info-property-record
  tag info-repair
  tag info-stock-condition
  tag info-energy-performance

  // Information types: products (exactly one on each dataset)
  tag info-product-specification
  tag info-test-evidence
  tag info-product-certificate
  tag info-product-data
  tag info-product-order
  tag info-supply-record
  tag info-product-performance-feedback

  // Authority (exactly one on each dataset)
  tag authoritative
  tag copy

  // IDCC builds, configures, integrates, standardises or directly influences this.
  // An IDCC intervention = idcc-scope + state-planned.
  tag idcc-scope

  // Software product chosen for a pilot
  tag pilot
}

// ==== model/styles.c4 ====

// Shared view styling. Every view applies it with:
//   global style idccConventions

global {
  styleGroup idccConventions {
    // Roadmap state: border style (current keeps the default solid border)
    style element.tag = #state-planned { border dashed }
    style element.tag = #state-retiring { border dotted }

    // IDCC scope: the one highlight colour
    style element.tag = #idcc-scope { color primary }

    // Retired last, so a retired element fades even if it was in IDCC scope
    style element.tag = #state-retired { color muted; opacity 30% }
  }
}

// ==== model/roles.c4 ====

// Organisation roles (ADR 0006): generic kinds of organisation, never named
// organisations. Named organisations appear only in a software product's `usedBy`.
// A role carries the stage tags of the systems it operates, so lifecycle lenses
// filter roles and systems together. A role is only modelled once it operates a
// system (regulator and delivery partner are in GLOSSARY.md but not yet here).

model {

  combinedAuthority = role 'Combined authority' {
    #housing-need #housing-pipeline
    summary 'A combined authority such as Liverpool City Region Combined Authority.'
    metadata { source 'Claude draft 2026-11-03' }
  }

  localAuthority = role 'Local authority' {
    #housing-approval
    summary 'A council, acting among other things as planning authority.'
    metadata { source 'Claude draft 2026-11-03' }
  }

  registeredProvider = role 'Registered provider' {
    #housing-pipeline #housing-scheme-design #housing-approval #housing-construction #housing-handover #housing-portfolio
    summary 'A social housing landlord registered with the regulator.'
    metadata { source 'Claude draft 2026-11-03' }
  }

  contractor = role 'Contractor' {
    #housing-scheme-design #housing-construction #housing-handover
    summary 'Builds or assembles a scheme on site, including in-house contractors.'
    metadata { source 'Claude draft 2026-11-03' }
  }

  architect = role 'Architect' {
    #housing-scheme-design
    metadata { source 'Claude draft 2026-11-03' }
  }

  manufacturer = role 'Manufacturer' {
    #product-development #product-cataloguing #product-manufacture #product-improvement #housing-construction
    summary 'Develops and makes industrialised construction products.'
    metadata { source 'Claude draft 2026-11-03' }
  }

  certificationBody = role 'Certification body' {
    #product-certification
    metadata { source 'Claude draft 2026-11-03' }
  }

  centralGovernment = role 'Central government' {
    #housing-handover #housing-portfolio
    metadata { source 'Claude draft 2026-11-03' }
  }

  funder = role 'Funder' {
    #housing-approval
    metadata { source 'Claude draft 2026-11-03' }
  }
}

// ==== model/capabilities.c4 ====

// Capabilities: flat list, verb + noun, tagged with the stages they belong to.
// A capability with no system supporting it is a gap; capabilities are only seen
// in system zoom views, so add one together with the system that supports it.

model {

  // Housing delivery lifecycle

  assessHousingNeed = capability 'Assess housing need' {
    #housing-need
    metadata { source 'Claude draft 2026-11-03' }
  }

  prioritisePipeline = capability 'Prioritise pipeline' {
    #housing-pipeline
    metadata { source 'Claude draft 2026-11-03' }
  }

  aggregateDemand = capability 'Aggregate demand' {
    #housing-pipeline #product-manufacture
    summary 'Combine the pipelines of many registered providers into demand manufacturers can plan for.'
    metadata { source 'Claude draft 2026-11-03' }
  }

  configureHomeDesign = capability 'Configure home design' {
    #housing-scheme-design
    metadata { source 'Claude draft 2026-11-03' }
  }

  appraiseScheme = capability 'Appraise scheme viability' {
    #housing-scheme-design #housing-approval
    metadata { source 'Claude draft 2026-11-03' }
  }

  determinePlanningApplication = capability 'Determine planning application' {
    #housing-approval
    metadata { source 'Claude draft 2026-11-03' }
  }

  approveFunding = capability 'Approve funding' {
    #housing-approval
    metadata { source 'Claude draft 2026-11-03' }
  }

  manageConstructionInformation = capability 'Manage construction information' {
    #housing-construction #housing-handover
    metadata { source 'Claude draft 2026-11-03' }
  }

  trackConstructionProgress = capability 'Track construction progress' {
    #housing-construction
    metadata { source 'Claude draft 2026-11-03' }
  }

  manageHomes = capability 'Manage homes' {
    #housing-portfolio
    metadata { source 'Claude draft 2026-11-03' }
  }

  planMaintenance = capability 'Plan maintenance' {
    #housing-portfolio
    metadata { source 'Claude draft 2026-11-03' }
  }

  // Product lifecycle

  developProduct = capability 'Develop product' {
    #product-development
    metadata { source 'Claude draft 2026-11-03' }
  }

  certifyProduct = capability 'Certify product' {
    #product-certification
    metadata { source 'Claude draft 2026-11-03' }
  }

  publishProductData = capability 'Publish product data' {
    #product-cataloguing
    metadata { source 'Claude draft 2026-11-03' }
  }

  manufactureAndSupplyProducts = capability 'Manufacture and supply products' {
    #product-manufacture
    metadata { source 'Claude draft 2026-11-03' }
  }

  learnFromProductPerformance = capability 'Learn from product performance' {
    #product-improvement
    metadata { source 'Claude draft 2026-11-03' }
  }
}

// ==== model/standards.c4 ====

// Standards that datasets conform to (conformsTo) and flows use (`standards` metadata).

model {

  ifc = standard 'IFC' {
    #state-current
    summary 'Industry Foundation Classes: open data model for building information (ISO 16739).'
    metadata { publisher 'buildingSMART International'; source 'Claude draft 2026-11-03' }
  }

  uniclass = standard 'Uniclass' {
    #state-current
    summary 'UK classification system for the built environment.'
    metadata { publisher 'NBS'; source 'Claude draft 2026-11-03' }
  }

  etim = standard 'ETIM' {
    #state-current
    summary 'Classification model for technical product information.'
    metadata { publisher 'ETIM International'; source 'Claude draft 2026-11-03' }
  }

  idccDataStandards = standard 'IDCC information standards' {
    #state-planned #idcc-scope
    summary 'Placeholder for the information standards IDCC will define or influence; to be split as they take shape.'
    metadata { publisher 'IDCC'; source 'Claude draft 2026-11-03' }
  }
}

// ==== model/systems/assetManagementSystem.c4 ====

model {

  assetManagementSystem = system 'Asset management system' {
    #housing-portfolio
    summary "A registered provider's system for stock condition, investment planning and compliance."
    metadata { source 'Claude draft 2026-11-03' }

    propertyRecords = dataset 'Property records' {
      #info-property-record #copy #state-current
      metadata { source 'Claude draft 2026-11-03' }
    }

    stockCondition = dataset 'Stock condition' {
      #info-stock-condition #authoritative #state-current
      metadata { source 'Claude draft 2026-11-03' }
    }

    energyPerformance = dataset 'Energy performance' {
      #info-energy-performance #copy #state-current
      metadata { source 'Claude draft 2026-11-03' }
    }
  }

  registeredProvider -[operates]-> assetManagementSystem
  assetManagementSystem -[supports]-> planMaintenance

  assetManagementSystem.stockCondition -[api]-> productFeedbackSystem.productPerformanceFeedback 'condition of installed products' {
    #state-planned #idcc-scope
    metadata { frequency 'monthly'; standards ['idccDataStandards']; source 'Claude draft 2026-11-03' }
  }
}

views {

  // Zoom view: opens when this system is clicked on the map (ADR 0007)
  view assetManagementSystemZoom of assetManagementSystem {
    title 'Asset management system'
    description 'Zoom into this system: the information it holds, who operates it, the capabilities it supports and the systems it exchanges information with.'
    include *
    include * -> assetManagementSystem where kind is operates
    include assetManagementSystem -> * where kind is supports
    global style idccConventions
    autoLayout LeftRight
  }
}

// ==== model/systems/certificationManagementSystem.c4 ====

model {

  certificationManagementSystem = system 'Certification management system' {
    #product-certification
    summary "A certification body's system for assessing products and issuing certificates."
    metadata { source 'Claude draft 2026-11-03' }

    testEvidence = dataset 'Test evidence' {
      #info-test-evidence #copy #state-current
      metadata { source 'Claude draft 2026-11-03' }
    }

    productCertificates = dataset 'Product certificates' {
      #info-product-certificate #authoritative #state-current
      metadata { source 'Claude draft 2026-11-03' }
    }
  }

  certificationBody -[operates]-> certificationManagementSystem
  certificationManagementSystem -[supports]-> certifyProduct

  certificationManagementSystem.productCertificates -[rekeying]-> productCatalogue.productCertificates 'certificate details re-entered' {
    #state-retiring
    metadata { frequency 'per certificate'; source 'Claude draft 2026-11-03' }
  }

  certificationManagementSystem.productCertificates -[api]-> productCatalogue.productCertificates 'digital certificates' {
    #state-planned #idcc-scope
    metadata { frequency 'on change'; standards ['idccDataStandards']; source 'Claude draft 2026-11-03' }
  }
}

views {

  // Zoom view: opens when this system is clicked on the map (ADR 0007)
  view certificationManagementSystemZoom of certificationManagementSystem {
    title 'Certification management system'
    description 'Zoom into this system: the information it holds, who operates it, the capabilities it supports and the systems it exchanges information with.'
    include *
    include * -> certificationManagementSystem where kind is operates
    include certificationManagementSystem -> * where kind is supports
    global style idccConventions
    autoLayout LeftRight
  }
}

// ==== model/systems/commonDataEnvironment.c4 ====

model {

  commonDataEnvironment = system 'Common data environment' {
    #housing-scheme-design #housing-construction #housing-handover
    summary "Shared repository for a scheme's design, construction and handover information."
    metadata { source 'Claude draft 2026-11-03' }

    homeDesigns = dataset 'Home designs' {
      #info-home-design #copy #state-current
      metadata { source 'Claude draft 2026-11-03' }
    }

    constructionProgress = dataset 'Construction progress' {
      #info-construction-progress #authoritative #state-current
      metadata { source 'Claude draft 2026-11-03' }
    }

    inspectionRecords = dataset 'Inspection records' {
      #info-inspection-record #authoritative #state-current
      metadata { source 'Claude draft 2026-11-03' }
    }

    handoverInformation = dataset 'Handover information' {
      #info-handover-information #authoritative #state-current
      metadata { source 'Claude draft 2026-11-03' }
    }
  }

  contractor -[operates]-> commonDataEnvironment
  commonDataEnvironment -[supports]-> manageConstructionInformation
  commonDataEnvironment -[supports]-> trackConstructionProgress

  commonDataEnvironment.homeDesigns -[fileTransfer]-> planningCaseManagementSystem.planningApplications 'drawings for planning submission' {
    #state-current
    metadata { frequency 'ad hoc'; source 'Claude draft 2026-11-03' }
  }

  commonDataEnvironment.constructionProgress -[rekeying]-> schemeManagementSystem.constructionProgress 'progress reports' {
    #state-current
    metadata { frequency 'monthly'; source 'Claude draft 2026-11-03' }
  }

  commonDataEnvironment.handoverInformation -[rekeying]-> housingManagementSystem.propertyRecords 'new homes set up from handover pack' {
    #state-retiring
    metadata { frequency 'per scheme'; source 'Claude draft 2026-11-03' }
  }

  commonDataEnvironment.handoverInformation -[api]-> housingManagementSystem.propertyRecords 'new homes created from handover information' {
    #state-planned #idcc-scope
    metadata { frequency 'per scheme'; standards ['idccDataStandards']; source 'Claude draft 2026-11-03' }
  }
}

views {

  // Zoom view: opens when this system is clicked on the map (ADR 0007)
  view commonDataEnvironmentZoom of commonDataEnvironment {
    title 'Common data environment'
    description 'Zoom into this system: the information it holds, who operates it, the capabilities it supports and the systems it exchanges information with.'
    include *
    include * -> commonDataEnvironment where kind is operates
    include commonDataEnvironment -> * where kind is supports
    global style idccConventions
    autoLayout LeftRight
  }
}

// ==== model/systems/configurator.c4 ====

model {

  configurator = system 'Configurator' {
    #housing-scheme-design #idcc-scope
    summary 'Composes products from a kit of parts into a home design. Many exist; IDCC does not mandate one (ADR 0005).'
    metadata { source 'Claude draft 2026-11-03' }

    schemeBriefs = dataset 'Scheme briefs' {
      #info-scheme-brief #copy #state-current
      metadata { source 'Claude draft 2026-11-03' }
    }

    productData = dataset 'Product data' {
      #info-product-data #copy #state-current
      metadata { source 'Claude draft 2026-11-03' }
    }

    homeDesigns = dataset 'Home designs' {
      #info-home-design #authoritative #state-current
      metadata { source 'Claude draft 2026-11-03' }
    }
  }

  architect -[operates]-> configurator
  configurator -[supports]-> configureHomeDesign
  configurator.homeDesigns -[conformsTo]-> ifc

  configurator.homeDesigns -[fileTransfer]-> commonDataEnvironment.homeDesigns 'design model export' {
    #state-current
    metadata { frequency 'ad hoc'; standards ['ifc']; source 'Claude draft 2026-11-03' }
  }
}

views {

  // Zoom view: opens when this system is clicked on the map (ADR 0007)
  view configuratorZoom of configurator {
    title 'Configurator'
    description 'Zoom into this system: the information it holds, who operates it, the capabilities it supports and the systems it exchanges information with.'
    include *
    include * -> configurator where kind is operates
    include configurator -> * where kind is supports
    global style idccConventions
    autoLayout LeftRight
  }
}

// ==== model/systems/demandAggregationSystem.c4 ====

model {

  demandAggregationSystem = system 'Demand aggregation system' {
    // #product-manufacture returns with its flow to manufacturers (aggregated demand, open)
    #housing-pipeline #state-planned #idcc-scope
    summary 'Combines the pipelines of many registered providers into demand that manufacturers can plan for. Operator not yet decided.'
    metadata { source 'Claude draft 2026-11-03' }

    housingNeed = dataset 'Housing need' {
      #info-housing-need #copy #state-planned #idcc-scope
      metadata { source 'Claude draft 2026-11-03' }
    }

    schemeProposals = dataset 'Scheme proposals' {
      #info-scheme-proposal #copy #state-planned #idcc-scope
      metadata { source 'Claude draft 2026-11-03' }
    }
  }

  demandAggregationSystem -[supports]-> aggregateDemand
  demandAggregationSystem.housingNeed -[conformsTo]-> idccDataStandards
  demandAggregationSystem.schemeProposals -[conformsTo]-> idccDataStandards
}

views {

  // Zoom view: opens when this system is clicked on the map (ADR 0007)
  view demandAggregationSystemZoom of demandAggregationSystem {
    title 'Demand aggregation system'
    description 'Zoom into this system: the information it holds, who operates it, the capabilities it supports and the systems it exchanges information with.'
    include *
    include * -> demandAggregationSystem where kind is operates
    include demandAggregationSystem -> * where kind is supports
    global style idccConventions
    autoLayout LeftRight
  }
}

